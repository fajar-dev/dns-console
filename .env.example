# All values are server-only. Never prefix secrets with NUXT_PUBLIC_.
NUXT_CLOUDFLARE_API_TOKEN=
NUXT_CLOUDFLARE_ACCOUNT_ID=
# Use a unique admin password of at least 12 characters.
NUXT_ADMIN_PASSWORD=
# Generate with: bun -e 'console.log(crypto.randomUUID() + crypto.randomUUID())'
NUXT_SESSION_PASSWORD=
NUXT_MYSQL_URL=mysql://dns_console:password@127.0.0.1:3306/dns_console
